# Vorlage — echte Werte NIE committen. Ziel: /opt/transitguard/shared/.env (chmod 600)
#
# Namensregel: Env-Name __ (Doppel-Unterstrich) = Config-Trenner ":".
# Der Name muss danach EXAKT dem Schluessel im Code entsprechen (Gross-/Kleinschreibung
# egal, Unterstriche NICHT). "INGEST__FEED_URL" wird zu "Ingest:FEED_URL" und trifft
# damit NICHT "Ingest:FeedUrl" — der Wert waere still wirkungslos.
# Abgesichert durch T-ENV-1 (tests/TransitGuard.Api.Tests/EnvVorlageTests.cs).

# --- Betriebsart: OHNE diese beiden Zeilen startet die API im In-Memory-Modus, --------
# --- mit konfigurierter, aber ungenutzter Datenbank und ohne Ingest. -----------------
Data__Provider=postgres
Jobs__Storage=postgres
Ingest__Enabled=true

# --- Datenbank (drei Rollen, docs/sql/0001_core.sql + 0003_rls.sql) ------------------
DATABASE__APP=Host=localhost;Database=transitguard;Username=tg_app;Password=CHANGE
DATABASE__BILLING=Host=localhost;Database=transitguard;Username=tg_billing;Password=CHANGE
# Hangfire-Auftragsspeicher, Schema "hangfire" (docs/sql/0006_hangfire.sql)
DATABASE__INGEST=Host=localhost;Database=transitguard;Username=tg_ingest;Password=CHANGE

# --- Ingest -------------------------------------------------------------------------
Ingest__FeedUrl=https://realtime.gtfs.de/realtime-free.pb
Ingest__City=hamburg
Ingest__StaticZipUrl=https://download.gtfs.de/germany/nv_free/latest.zip
# Der Poll-Takt steht NICHT hier: er ist Zeitplan-Konstante in JobSchedules (T-CRON).

# --- CORS: leer lassen. Prod liefert PWA und API unter EINEM Origin aus (Caddyfile). --
# Nur fuer lokale Laufzeittests setzen, z. B. Cors__AllowedOrigins=http://localhost:1234
Cors__AllowedOrigins=

# =====================================================================================
# Ab hier: Platzhalter fuer Funktionen, die der Code HEUTE NOCH NICHT liest.
# Bewusst behalten, damit der Deploy-Weg spaeter nicht umgebaut werden muss —
# aber sie tun aktuell nichts. Wer sie setzt, bekommt keine Wirkung.
# =====================================================================================
# SMTP fuer Ops-Alarme (docs/07 §8, F-19) — LoggingAlarmSink schreibt bislang nur ins Log.
OPS__ALERT_EMAIL=ops@example.de
OPS__SMTP_HOST=
OPS__SMTP_USER=
OPS__SMTP_PASS=
# Store-Validierung Apple/Google (T6.2, F-12) — Billing laeuft noch in der Sandbox.
BILLING__APPLE_KEY_ID=
BILLING__APPLE_ISSUER=
BILLING__APPLE_BUNDLE_ID=
BILLING__GOOGLE_PACKAGE=
BILLING__GOOGLE_SERVICE_ACCOUNT_JSON=
# Oeffentliche Adressen (Caddy kennt sie; die API baut heute keine absoluten URLs).
PUBLIC_URLS__API=https://api.example.de
PUBLIC_URLS__APP=https://app.example.de
